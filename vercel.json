{
  "version": 2,
  "builds": [
    { "src": "api/chat.js", "use": "@vercel/node" },
    { "src": "api/cities.js", "use": "@vercel/node" },
    { "src": "api/track.js", "use": "@vercel/node" },
    { "src": "partenaires.html", "use": "@vercel/static" },
    { "src": "logement.html", "use": "@vercel/static" }
  ],
  "routes": [
    { "src": "/api/chat", "dest": "/api/chat.js" },
    { "src": "/api/cities", "dest": "/api/cities.js" },
    { "src": "/api/track", "dest": "/api/track.js" }
  ],
  "rewrites": [
    { "source": "/", "destination": "/logement.html", "has": [{ "type": "host", "value": "logement.midzoflight.com" }] },
    { "source": "/", "destination": "/partenaires.html", "has": [{ "type": "host", "value": "partenaires.midzoflight.com" }] },
    { "source": "/", "destination": "/partenaires.html", "has": [{ "type": "host", "value": "api.midzoflight.com" }] }
  ]
}
